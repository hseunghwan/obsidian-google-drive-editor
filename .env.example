# No Google Picker API key is required for the MV3-compatible folder URL/ID prompt.

# Chrome 확장용 OAuth client id (Chrome Extension 유형). dist/manifest.json에 주입된다.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# 웹 배포용 OAuth client id (웹 애플리케이션 유형).
# Drive "연결 앱으로 열기"로 들어온 화면이 GIS 토큰 클라이언트로 쓴다. 확장 빌드에는 필요 없다.
VITE_GOOGLE_WEB_OAUTH_CLIENT_ID=
